{
  "name": "invoiceflow",
  "version": "0.1.0",
  "description": "Expense tracking and invoicing system - API + background worker",
  "main": "src/index.js",

  "overrides": {
    "node-pg-migrate": {
      "glob": "^11.1.0"
    }
  },
  
  "scripts": {
    "start:api": "node src/index.js",
    "start:worker": "node src/worker.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "lint:syntax": "node --check src/index.js src/worker.js src/queue.js src/db.js src/logger.js src/mailer.js src/pdf.js src/routes/invoices.js src/routes/clients.js src/routes/expenses.js",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.203.0",
    "@opentelemetry/propagator-jaeger": "^2.10.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.5",
    "prom-client": "^15.1.3",
    "node-pg-migrate": "^7.6.1"
  }
}
